# Gemini API Key (từ https://aistudio.google.com)
GEMINI_API_KEY=

# Base URL (Google Gemini)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

GENERATION_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite

# (Tùy chọn) OpenAI API Key nếu dùng OpenAI thay vì Gemini
OPENAI_API_KEY=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=
